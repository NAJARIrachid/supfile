# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Base de données PostgreSQL (utilisé par Prisma et Docker Compose)
DATABASE_URL=postgresql://supfile:supfile_secret@postgres:5432/supfile?schema=public

# JWT — générer une clé forte en production (openssl rand -base64 64)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS — origine du frontend React
CORS_ORIGIN=http://localhost:5173

# Stockage physique des fichiers (volume Docker monté sur ./uploads)
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=100

# Google OAuth2 (console Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# URL publique du backend (redirections OAuth)
BACKEND_URL=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
